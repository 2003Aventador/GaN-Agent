    {
      "id": "s7_trap",
      "name": "陷阱（Pulse IV 色散）",
      "data_kinds": ["pulse"],
      "views": [],
      "param_group": ["trapmod", "rtrap1", "ctrap1"],
      "selection": "xr(0,1)",
      "skip_when": "无 Pulse 数据",
      "degrade": {"action": "literature_default", "note": "Pulse 缺失：trapmod=0 关闭陷阱效应（卡默认），登记风险"}
